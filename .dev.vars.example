# Local secrets for `wrangler pages dev` (copy to .dev.vars — gitignored).
# In production set these as encrypted secrets instead:
#   npx wrangler pages secret put MAPBOX_ACCESS_TOKEN
#   npx wrangler pages secret put TURNSTILE_SECRET_KEY
#   npx wrangler pages secret put ANTHROPIC_API_KEY

# Mapbox public token (pk.…). Restrict it to your site's URLs in the Mapbox dashboard.
MAPBOX_ACCESS_TOKEN=

# Cloudflare's always-passes TEST secret — pairs with the test site key in .env.example.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Only needed for the admin Snap-a-Deal photo extraction.
ANTHROPIC_API_KEY=

# Skip Cloudflare Access verification for /api/admin/* in local dev. Honoured only
# for requests to localhost / 127.0.0.1 — never set this on a deployed environment.
DEV_BYPASS_ACCESS=1
