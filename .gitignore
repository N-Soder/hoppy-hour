# Environment files — never commit these. .env.example stays committed as the
# template; deployed values live in Cloudflare Pages build settings.
.env
.env.*
!.env.example

# Private local notes — never committed
/AUDIT.md
/MIGRATION.md

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Wrangler local dev state (miniflare D1/KV) — never commit
.wrangler
# Data exports / SQL dumps — never commit real data
*.csv
*.sql.gz
/import.sql
/dump*.sql

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local dev secrets (.dev.vars.example stays committed as the template)
.dev.vars
.dev.vars.*
!.dev.vars.example

# Local smoke-test scratch (miniflare persist, logs)
.smoke
