# Vite build-time variables (copy to .env for local dev; in production set them
# in Cloudflare Pages → Settings → Build → Environment variables).
# Everything here is PUBLIC — it is compiled into the client bundle.

# Default map centre when geolocation is unavailable (defaults to Perth, WA).
VITE_DEFAULT_LNG=115.8605
VITE_DEFAULT_LAT=-31.9505
VITE_DEFAULT_LOCATION_NAME="Perth, Western Australia"

# Cloudflare Turnstile site key for the submit form's bot check.
# This is Cloudflare's always-passes TEST key — replace it with your own widget's
# site key in production.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-side secrets for the /api Functions do NOT go here — see .dev.vars.example.
